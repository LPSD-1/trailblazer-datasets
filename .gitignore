# Python bytecode. Committed by accident once; it is build output, it is
# platform- and version-specific, and a stale copy of it made a restored file
# look like a mutated one for a whole test run.
__pycache__/
*.py[cod]

# Build output. dist/ is assembled from the tools on every run and published
# from there; nothing in it is a source.
dist/

# The rights-of-way cache. Tens of thousands of council records, refetched by
# fetch_rights_of_way.py and cached by the workflow rather than by git.
cache/

# CREDENTIALS. Nothing in here is ever committed.
#
# D-TRO consumer access is OAuth 2.0 client credentials (TRO_SPEC.md 1.2), and
# the ingestion that will use them runs from this repo. Added BEFORE any
# credential existed on disk: a secret that reaches a public repo is not
# "removed" by a later commit, it is rotated, and a .gitignore written after
# the fact is written too late.
#
# Local runs read them from .env; the workflow reads them from GitHub Actions
# secrets, which never touch the working tree at all.
.env
.env.*
# ...except the template, which is the whole point of having one: it carries
# the variable names and the traps, and no values.
!.env.example
secrets/
*.key
*.pem

# Scratch, backups and cross-repo droppings.
#
# Agents doing mutation testing copy a file aside, break it, run the suite and
# put it back, which leaves `.bak` files about. A shared scratchpad once got
# bulk-copied into this repository's root, landing fourteen Dart files and two
# routing profiles from the APP repo here - none of which belong in a builder
# repo at all. Nothing caught it but a human reading `git status`.
#
# So: this repo builds datasets. Dart does not live here.
*.dart
*.bak
*.orig
*.rej
/*.brf

# Local build staging. height.yml and satellite.yml both stage into a
# top-level staging/ directory, and build_height.py documents it in its own
# usage - so a human running a local build would otherwise have it turn up
# untracked, full of large files, waiting to be committed by accident.
staging/
