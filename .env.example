# D-TRO consumer credentials. Copy to .env and fill in; .env is gitignored.
#
# OAuth 2.0 client credentials (TRO_SPEC.md 1.2): HTTP basic with the client id
# and secret against POST /oauth-generator, which returns a bearer token good
# for 1799 seconds.
#
# SEPARATE CREDENTIALS PER ENVIRONMENT - the spec says so, and sandbox
# credentials pointed at production fail as 401, which reads exactly like an
# expired token. Keep both here and switch DTRO_BASE_URL rather than editing
# one pair back and forth.
DTRO_CLIENT_ID=
DTRO_CLIENT_SECRET=

# Which environment the id and secret above belong to.
DTRO_BASE_URL=

# Never commit the filled-in copy. If one is ever pushed, rotate it with
# d-tro@dft.gov.uk rather than deleting the commit: a secret that has reached a
# remote is spent, whatever the history says afterwards.
