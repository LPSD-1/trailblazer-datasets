# D-TRO consumer credentials. Copy this file to .env and fill it in.
# .env is gitignored; this template is not, and must never gain a real value.

# WHICH FIELD IS WHICH.
#
# The developer portal issues three things - an App ID, an API Key and an API
# Secret - and TRO_SPEC.md 1.2 describes the token call as "HTTP basic with the
# client ID and secret". They line up like this:
#
#   API Key    -> client ID      ) the HTTP basic pair sent to
#   API Secret -> client secret  ) POST /oauth-generator
#   App ID     -> the registration's own identifier, not part of the token call
#
# That mapping is the portal's usual one and it is CHECKED BY CALLING THE
# ENDPOINT, not assumed: tools/dtro_token.py exchanges them for a token and
# reports which field it used. If a 401 comes back, try the App ID as the
# client ID before assuming the credentials are wrong.
DTRO_APP_ID=
DTRO_CLIENT_ID=
DTRO_CLIENT_SECRET=

# WHICH ENVIRONMENT THEY BELONG TO. Credentials are per environment, so a
# sandbox pair pointed at production fails as 401 - which reads exactly like an
# expired token, and is the one confusion worth spending a line to prevent.
#
#   integration (test) https://dtro-integration.dft.gov.uk/v1
#   production         https://dtro.dft.gov.uk/v1
DTRO_BASE_URL=https://dtro-integration.dft.gov.uk/v1

# If a filled-in copy ever reaches a remote, rotate with d-tro@dft.gov.uk
# rather than deleting the commit. A secret that has left the machine is spent,
# whatever the history says afterwards.
